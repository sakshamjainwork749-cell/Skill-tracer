# SQLite is the zero-configuration default. PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://skilltrace:skilltrace@localhost:5432/skilltrace
DATABASE_URL=sqlite:///./skilltrace.db
JWT_SECRET=replace-this-with-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000","http://localhost:4173","http://127.0.0.1:4173"]
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=5242880
AUTO_CREATE_TABLES=true
AUTO_SEED_DEMO=true
PROVINCE=Maharashtra
FRONTEND_URL=http://localhost:3000
FOLLOWUP_EMPLOYED_DAYS=90
FOLLOWUP_SEEKING_JOB_DAYS=30
FOLLOWUP_RETENTION_6M_DAYS=180
FOLLOWUP_RETENTION_12M_DAYS=365
NOTIFICATION_MODE=console
WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_TEMPLATE_SID=
EMAIL_ENABLED=false
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_API_KEY=
# WhatsApp provider abstraction: demo | twilio | meta (Meta Cloud API).
# Tokens stay server-side; the frontend only ever sees provider: demo/ready.
WHATSAPP_PROVIDER=demo
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_SECRET=
# For Meta production delivery, create an approved template with one body
# variable ({{1}}) for SkillTrace's privacy-minimised follow-up message.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
FOLLOWUP_LINK_EXPIRE_HOURS=168
